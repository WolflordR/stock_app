# Copy this file to .env.nas and change TRADE_NAS_ROOT to your mounted NAS path.
# Recommended NAS layout:
#   ${TRADE_NAS_ROOT}/data/db
#   ${TRADE_NAS_ROOT}/data/raw
#   ${TRADE_NAS_ROOT}/logs
#   ${TRADE_NAS_ROOT}/backups
TRADE_NAS_ROOT=/private/tmp/trade_nas

TRADE_DATA_DIR=${TRADE_NAS_ROOT}/data
TRADE_DB_DIR=${TRADE_NAS_ROOT}/data/db
TRADE_RAW_DATA_DIR=${TRADE_NAS_ROOT}/data/raw
TRADE_PROCESSED_DATA_DIR=${TRADE_NAS_ROOT}/data/processed
TRADE_CACHE_DIR=${TRADE_NAS_ROOT}/data/cache
TRADE_LOGS_DIR=${TRADE_NAS_ROOT}/logs
TRADE_BACKUPS_DIR=${TRADE_NAS_ROOT}/backups

TRADE_API_HOST=127.0.0.1
TRADE_API_PORT=8000
TRADE_WEB_HOST=127.0.0.1
TRADE_WEB_PORT=8080
TRADE_API_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Web open warm-up.
# Turn this on when you want opening the site to trigger a once-per-day background price cache update.
TRADE_WEB_BOOTSTRAP_PRICE_ENABLED=1
TRADE_WEB_BOOTSTRAP_PRICE_DAYS=1825
TRADE_WEB_BOOTSTRAP_PRICE_FORCE=0
