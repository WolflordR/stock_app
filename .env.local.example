# Copy this file to .env.local for Mac local scheduled updates.

# Price update scope.
# all = update every stock in the local stock master.
# list = update only TRADE_DAILY_PRICE_STOCKS.
TRADE_DAILY_PRICE_SCOPE=all

# Used only when TRADE_DAILY_PRICE_SCOPE=list.
TRADE_DAILY_PRICE_STOCKS=2330,2317,2454

# Price history window to refresh.
TRADE_DAILY_PRICE_DAYS=1825

# Set to 1 when you want failed symbols to retry immediately.
TRADE_DAILY_PRICE_FORCE=0

# Optional heavier refreshes. Turn these on only after the basic schedule is stable.
TRADE_DAILY_REFRESH_STOCK_MASTER=0
TRADE_DAILY_REFRESH_REVENUE=0
TRADE_DAILY_REFRESH_COMPANY_LINKS=0
TRADE_DAILY_REFRESH_MARKET_MAP=0

# Broker CSV import.
# If data/raw/broker/twse/YYYY-MM-DD exists, the local update script imports it automatically.
TRADE_DAILY_IMPORT_BROKER=1
